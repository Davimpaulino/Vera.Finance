{
  "name": "vera-finance-backend",
  "version": "1.0.0",
  "description": "API do vera.finance — Node.js puro (MVC sem view) com Firebase",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:pg": "BANCO_TESTE=postgres node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "migrar:postgres": "node --env-file-if-exists=.env scripts/migrar-firebase-para-postgres.mjs",
    "regras:firebase": "node --env-file-if-exists=.env scripts/publicar-regras-firebase.mjs",
    "saude:redes": "node --env-file-if-exists=.env scripts/saude-das-redes.mjs",
    "emails:ver": "node scripts/ver-emails.mjs"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "firebase-admin": "^14.5.1",
    "pg": "^8.23.1"
  }
}
